# Neon pooled connection — used by the app at runtime.
# Must be the -pooler host, or serverless will exhaust connections.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/cour?sslmode=require"

# Neon direct (non-pooled) connection — used by `prisma migrate` only.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cour?sslmode=require"

# MyAnimeList API v2 client id, from https://myanimelist.net/apiconfig
# Never commit a real value. Never share it (MAL agreement §2(a)).
MAL_CLIENT_ID=""

# Conservative default: MAL publishes no rate limit, so we set our own.
MAL_REQUESTS_PER_SECOND="1"

# Bayesian shrinkage: votes of the global mean blended into every score.
# Config, not code, so it can be tuned without a deploy.
RATING_BAYES_PRIOR_VOTES="20"
